          "request": { "method": "DELETE", "header": [{ "key": "Accept", "value": "application/json" }], "url": "{{baseUrl}}/api/modelos/{{modeloId}}" },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Elimina el modelo', function () { pm.response.to.have.status(204); });"] } }]
        },
        {
          "name": "Eliminar marca",
          "request": { "method": "DELETE", "header": [{ "key": "Accept", "value": "application/json" }], "url": "{{baseUrl}}/api/marcas/{{marcaId}}" },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Elimina la marca', function () { pm.response.to.have.status(204); });"] } }]
        },
        {
          "name": "Desasignar rol",
          "request": { "method": "DELETE", "header": [{ "key": "Accept", "value": "application/json" }], "url": "{{baseUrl}}/api/usuario-roles/{{usuarioId}}/{{rolId}}" },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Desasigna el rol', function () { pm.response.to.have.status(204); });"] } }]
        },
        {
          "name": "Eliminar usuario",
          "request": { "method": "DELETE", "header": [{ "key": "Accept", "value": "application/json" }], "url": "{{baseUrl}}/api/usuarios/{{usuarioId}}" },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Elimina el usuario', function () { pm.response.to.have.status(204); });"] } }]
        },
        {
          "name": "Eliminar rol",
          "request": { "method": "DELETE", "header": [{ "key": "Accept", "value": "application/json" }], "url": "{{baseUrl}}/api/roles/{{rolId}}" },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Elimina el rol', function () { pm.response.to.have.status(204); });"] } }]
        }
